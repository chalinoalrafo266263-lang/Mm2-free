local antiFlingEnabled = false
local antiFlingConn = nil
local antiFlingLastPos = nil
local ANTI_FLING_MAX_SPEED = 300

function enableAntiFling()
	if antiFlingEnabled then
		return
	end

	antiFlingEnabled = true
	antiFlingLastPos = nil

	antiFlingConn = RunService.Heartbeat:Connect(function()
		if not antiFlingEnabled then
			return
		end

		local character = LP.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")

		if not hrp then
			antiFlingLastPos = nil

			return
		end

		for _, child in ipairs(hrp:GetChildren()) do
			local isForced = child:IsA("BodyVelocity")
				or child:IsA("BodyForce")
				or child:IsA("VectorForce")
				or child:IsA("BodyAngularVelocity")
				or child:IsA("LinearVelocity")
				or child:IsA("BodyGyro")

			if isForced and child.Name ~= "FarmBV" and child.Name ~= "AntiFlingProtect" then
				child:Destroy()
			end
		end

		local velocity = hrp.AssemblyLinearVelocity

		if velocity.Magnitude > ANTI_FLING_MAX_SPEED then
			if antiFlingLastPos then
				hrp.CFrame = CFrame.new(antiFlingLastPos)
			end

			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		elseif velocity.Magnitude < 100 then
			antiFlingLastPos = hrp.Position
		end
	end)
end

function disableAntiFling()
	antiFlingEnabled = false

	if antiFlingConn then
		antiFlingConn:Disconnect()
		antiFlingConn = nil
	end
end

function isAntiFlingEnabled()
	return antiFlingEnabled
end

