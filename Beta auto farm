local CONFIG_FILE = "yupitactico_hub_config.json"

local function hasFileAPI()
	local ok, result = pcall(function()
		return type(writefile) == "function" and type(readfile) == "function"
	end)

	return ok and result == true
end

function saveConfig()
	if not hasFileAPI() then
		print("[yupitactico hub] Tu executor no soporta writefile/readfile")

		return
	end

	local data = {
		autoFarm = _G.MM2.autoFarm == true,
		autoGun = _G.MM2.autoGun == true,
		flingMurderer = t1.value22 == true,
		flingSheriff = t1.value23 == true,
		flingAll = t1.value24 == true,
		silentAim = _G.MM2.silentAim == true,
		showFovCircle = _G.MM2.showFovCircle == true,
		fovRadius = _G.MM2.fovRadius,
		bulletTracer = _G.MM2.bulletTracer == true,
		murdererLine = _G.MM2.murdererLine == true,
		autoEquip = _G.MM2.autoEquip == true,
		antiFling = isAntiFlingEnabled() == true,
		rutaSpeed = _G.MM2.rutaSpeed
	}

	local ok, err = pcall(function()
		writefile(CONFIG_FILE, HttpService:JSONEncode(data))
	end)

	if ok then
		print("[yupitactico hub] Config guardada: " .. CONFIG_FILE)
	else
		print("[yupitactico hub] Error al guardar config: " .. tostring(err))
	end
end

function loadConfig(silent)
	if not hasFileAPI() then
		if not silent then
			print("[yupitactico hub] Tu executor no soporta writefile/readfile")
		end

		return
	end

	local okRead, content = pcall(readfile, CONFIG_FILE)

	if not okRead or type(content) ~= "string" then
		if not silent then
			print("[yupitactico hub] Todavia no hay config guardada")
		end

		return
	end

	local okDecode, data = pcall(function()
		return HttpService:JSONDecode(content)
	end)

	if not okDecode or type(data) ~= "table" then
		if not silent then
			print("[yupitactico hub] La config guardada no es valida")
		end

		return
	end

	if type(data.rutaSpeed) == "number" then
		_G.MM2.rutaSpeed = data.rutaSpeed
	end

	if data.autoFarm == true and not _G.MM2.autoFarm then
		_G.MM2.autoFarm = true
		startCoinFarm()

		if t1.value1 then
			t1.value1.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
			t1.value1.Text = "AUTO FARM 50%: ON"
		end
	end

	_G.MM2.autoGun = data.autoGun == true

	if data.flingMurderer == true then
		t1.value22 = true
		t1.value23 = false
		t1.value24 = false
	elseif data.flingSheriff == true then
		t1.value23 = true
		t1.value22 = false
		t1.value24 = false
	elseif data.flingAll == true then
		t1.value24 = true
		t1.value22 = false
		t1.value23 = false
	end

	_G.MM2.silentAim = data.silentAim == true
	_G.MM2.showFovCircle = data.showFovCircle ~= false
	_G.MM2.bulletTracer = data.bulletTracer ~= false
	_G.MM2.murdererLine = data.murdererLine == true
	_G.MM2.autoEquip = data.autoEquip == true

	if type(data.fovRadius) == "number" then
		_G.MM2.fovRadius = data.fovRadius
	end

	if data.antiFling == true then
		enableAntiFling()
	end

	if not silent then
		print("[yupitactico hub] Config cargada")
	end
end

